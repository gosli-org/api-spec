import "@typespec/http";
import "@typespec/openapi";

@service(#{ title: "API Spec" })
namespace ApiSpec;

namespace Client {
    enum RequestType {
        listProjects,
        createSession,
        attachSession,
    }

    model Request {
        /** Unique request ID generated by the sender, e.g. a UUID string. */
        id: string;
        type: RequestType;
        token: string;
    }
}
